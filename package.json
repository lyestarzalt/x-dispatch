{
  "name": "x-dispatch",
  "productName": "X-Dispatch",
  "version": "2.0.1",
  "description": "Flight dispatch, airport visualization, and addon management for X-Plane 12",
  "author": {
    "name": "Lyes Tarzalt"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/lyestarzalt/x-dispatch"
  },
  "homepage": "https://x-dispatch.app/",
  "keywords": [
    "x-plane",
    "x-plane-12",
    "flight-simulator",
    "flight-planning",
    "flight-dispatch",
    "airport",
    "aviation",
    "addon-manager",
    "simbrief",
    "vatsim",
    "electron",
    "maplibre"
  ],
  "main": ".vite/build/main.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "start:clean": "rm -rf .vite && electron-forge start",
    "start:fresh": "electron-forge start -- --reset-cache",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:run && npm run check:migrations",
    "check:migrations": "node scripts/check-drizzle-migrations.mjs",
    "i18n:sync": "node scripts/sync-locales.mjs",
    "i18n:sync:dry": "node scripts/sync-locales.mjs --dry-run",
    "postinstall": "node -e \"try{require('fs').chmodSync(require('7zip-bin').path7za,0o755)}catch{}\"",
    "prepare": "husky",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:xplane": "npx tsx scripts/test-xplane-websocket.ts",
    "test:e2e": "playwright test",
    "test:e2e:build": "E2E_BUILD=1 electron-forge package",
    "bench:map": "node scripts/map-bench.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@reforged/maker-appimage": "^5.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.103.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/electron-window-state": "^5.0.2",
    "@types/node": "^26.6.2",
    "@types/node-7z": "^2.1.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/suncalc": "^1.9.2",
    "@types/three": "^0.186.0",
    "@types/tz-lookup": "^6.1.2",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "^3.4.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.4.4",
    "eslint": "^10.11.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "src/lib/db/schema.ts": [
      "bash -c 'npx drizzle-kit generate --name auto-$(date +%Y%m%d%H%M%S) && git add drizzle/'",
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "tar": ">=7.5.22",
    "@xmldom/xmldom": ">=0.8.10 <0.9.0"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/maplibre": "^9.4.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@geoql/maplibre-gl-starfield": "^0.1.2",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@recent-cli/resolve-lnk": "^0.0.2",
    "@sentry/electron": "^7.20.0",
    "@sentry/react": "10.75.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tanstack/react-query": "^5.103.2",
    "7zip-bin": "^5.2.0",
    "bufferutil": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.3",
    "electron-log": "^5.4.4",
    "electron-squirrel-startup": "^1.0.1",
    "electron-window-state": "^5.0.3",
    "i18next": "^26.4.2",
    "lucide-react": "^1.47.0",
    "maplibre-contour": "^0.1.1",
    "maplibre-gl": "^6.11.0",
    "metar-taf-parser": "^9.1.3",
    "node-7z": "^3.0.0",
    "node-unrar-js": "^2.0.2",
    "react-i18next": "^17.0.15",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "sql.js": "^1.14.2",
    "suncalc": "^2.0.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.186.0",
    "tz-lookup": "^6.1.25",
    "update-electron-app": "^3.3.0",
    "utf-8-validate": "^6.0.6",
    "ws": "^8.21.3",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
